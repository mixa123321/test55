{
  "name": "ab/warehouse",
  "description": "AB Fulfilment",
  "type": "project",
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "microsoft/azure-storage-blob": "1.5.4",
    "psr/simple-cache": "1.0.1"
  },
  "config": {
    "vendor-dir": "composer_vendors"
  },
  "require-dev": {
    "vimeo/psalm": "5.26.1",
    "codeception/codeception": "4.2.2",
    "codeception/module-webdriver": "1.4.1",
    "codeception/module-asserts": "1.3.1",
    "codeception/module-db": "1.2.0"
  },
  "scripts": {
    "psalm": "composer_vendors/bin/psalm --no-cache --report-show-info=false",
    "codecept:build": "composer_vendors/bin/codecept build",
    "db:acceptance:reset": "php tests/Support/Commands/reset_acceptance_data.php",
    "db:acceptance:seed": "php tests/Support/Commands/seed_acceptance_data.php",
    "test:acceptance": [
      "@db:acceptance:reset",
      "@db:acceptance:seed",
      "composer_vendors/bin/codecept run Acceptance"
    ],
    "test:acceptance:debug": [
      "@db:acceptance:reset",
      "@db:acceptance:seed",
      "composer_vendors/bin/codecept run Acceptance --debug"
    ],
    "test:unit": "composer_vendors/bin/codecept run Unit",
    "semgrep": "semgrep --config=p/php --config=p/security-audit --config=p/secrets --config=.semgrep --metrics=off app robot sql dev",
    "semgrep:diff": "semgrep --config=p/php --config=p/security-audit --config=p/secrets --metrics=off --error --baseline-commit=origin/master .",
    "sast": [
      "@psalm",
      "@semgrep:diff",
      "composer audit"
    ],
    "sast:full": [
      "@psalm",
      "@semgrep",
      "composer audit"
    ],
    "security-audit": "bash tools/security-audit.sh"
  }
}
