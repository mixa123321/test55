/docker/sftpgo/home/

# Redundant loose private key — the same key material is already bundled
# into the committed docker/kv-emulator/dev-cert/emulator.pfx, which is what
# kv-emulator actually uses. Never intentionally commit this one.
/docker/kv-emulator/dev-cert/key.pem

# Developer's own config secrets for the Key Vault emulator (seeded as `app-config` by seed-secrets.sh)
/docker/kv-emulator/app-config.local.json

/docker/nginx/logs/*
!/docker/nginx/logs/.gitkeep

/tests/_output/*
!/tests/_output/.gitkeep
tests/Support/_generated/

/robot/tasks/draft/

